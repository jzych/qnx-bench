system qnx-guest-2

ram 0x80000000,512M
cpu

load /qnx/system_b/guests/qnx-guest-2/qnx800-guest-2.ifs

vdev pl011
        hostdev >-
        loc 0x1c090000
        intr gic:37

vdev virtio-console
        loc 0x20000000
        intr gic:42

vdev shmem
        loc 0x1c050000 intr
        gic:38

vdev wdt-sp805
        loc 0x1c0f0000

vdev smmu
